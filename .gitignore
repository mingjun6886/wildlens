# ML model weights — never commit (200-270 MB each)
*.pt
*.pth
*.onnx

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
# Note: .terraform.lock.hcl IS committed — it pins provider versions so that
# a local plan and a CI plan resolve to the same provider builds.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node / web
node_modules/
dist/

# Secrets and local overrides
.env
*.local.env
credentials

# macOS
.DS_Store

# Vietnamese working notes live outside the repository (~/Projects/wildlens-vi).
# These patterns are a safety net in case one is ever copied in by mistake.
*-vi.*
*.vi.md
/vi/
docs/vi/

# Lambda zips built by Terraform's archive_file provider. Regenerated on every
# apply, so committing one only produces churn — and a stale copy in the tree is
# worse than none, since it looks like the deployed artefact and is not.
**/.build/

# --- web client --------------------------------------------------------------
node_modules/
web/dist/
# Generated from Terraform output by scripts/write-web-env.sh. Every value in it
# changes on a destroy/apply cycle, so a committed copy is wrong as soon as
# somebody recreates the estate.
web/.env.local
